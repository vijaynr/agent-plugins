# Legacy Black Duck API configuration.
# Preferred: run blackduck_token.py login. It stores the token in the OS keyring
# and non-secret named-profile metadata in the stable per-user AgentDevelopmentToolkit
# config directory, so this plugin-local .env is not required.
# Existing unambiguous keyring-backed .env metadata is migrated automatically;
# this file is never deleted or rewritten. Direct tokens are never migrated.

BLACKDUCK_URL=https://blackduck.example.com
# Direct-token fallback for CI/non-interactive environments. For durable login,
# inject BLACKDUCK_LOGIN_TOKEN through a masked launcher environment and run:
#   uv run scripts/blackduck_token.py login --profile <name> --url <url> --verify-ssl <true-or-false>
BLACKDUCK_TOKEN=
# BLACKDUCK_TOKEN_KEYRING_USER=https://blackduck.example.com

# Optional: set to false for self-signed certificates
# BLACKDUCK_VERIFY_SSL=true
