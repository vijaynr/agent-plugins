# Legacy/CI GitLab environment configuration.
# Normal login uses OS keyring plus stable per-user profile metadata; copying
# this file is not required. The script can still load a legacy .env.

# Required when using a direct CI token or explicit keyring-user override.
GITLAB_API_URL=https://gitlab.example.com/api/v4

# Preferred: use gitlab_token.py login. It stores the token in the OS
# credential store and non-secret profile metadata in the stable per-user
# AgentDevelopmentToolkit config directory, so this legacy .env is not required.
# Existing keyring-backed .env metadata is migrated automatically when it is
# unambiguous; this file is never deleted or rewritten during migration.
# Fallback: set GITLAB_PERSONAL_ACCESS_TOKEN directly here for CI/non-interactive
# environments. Direct tokens are never migrated.
# To create/update a durable profile, inject GITLAB_LOGIN_TOKEN through a
# masked launcher environment and run without putting its value in command text:
#   uv run scripts/gitlab_token.py login --profile <name> --api-url <url>
GITLAB_PERSONAL_ACCESS_TOKEN=
# GITLAB_TOKEN_KEYRING_USER=https://gitlab.example.com/api/v4

# Optional: Default project ID (avoids passing --param project_id=... every time)
GITLAB_PROJECT_ID=

# Optional: Comma-separated list of allowed project IDs (empty = allow all)
GITLAB_ALLOWED_PROJECT_IDS=

# Optional: Set to true to block all write operations
GITLAB_READ_ONLY_MODE=false

# Optional: Request timeout in seconds
GITLAB_TIMEOUT=60
