# -----------------------------------------------------------------
# Legacy/CI ALM Octane environment configuration.
# Normal interactive login uses OS keyring plus stable per-user profile metadata;
# copying this file is not required.
# -----------------------------------------------------------------

# Required only when using this legacy/direct environment configuration.
OCTANE_BASE_URL=https://octane.example.com

# Preferred: use octane_token.py login. It stores the secret in the OS
# credential store and non-secret profile metadata in the stable per-user
# AgentDevelopmentToolkit config directory, so this legacy .env is not required.
# Existing keyring-backed .env metadata is migrated automatically when it is
# unambiguous; this file is never deleted or rewritten during migration.
# Fallback: set OCTANE_CLIENT_ID + OCTANE_CLIENT_SECRET directly here for
# CI/non-interactive environments. Direct secrets are never migrated.
# To create/update a durable named profile and verify it from this skill root:
#   Inject OCTANE_LOGIN_SECRET with a masked launcher environment, then run:
#   uv run scripts/octane_token.py login --profile <name> --base-url <url> --user <client-id> --shared-space-id <id> --workspace-id <id>
OCTANE_CLIENT_ID=
OCTANE_CLIENT_SECRET=
# OCTANE_CLIENT_SECRET_KEYRING_USER=<client id>

# Optional — defaults shown
OCTANE_SHARED_SPACE_ID=131002
OCTANE_WORKSPACE_ID=1003
OCTANE_TIMEOUT=30

# Optional — override Octane custom field logical/API names when metadata
# resolution cannot map these UI labels automatically.
# OCTANE_SECURITY_ASSESSMENT_FIELD=security_assessment
# OCTANE_SECURITY_IMPACT_LEVEL_FIELD=security_impact_level
# OCTANE_ALLOW_DELETE_FIELD=allow_delete_udf
